{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "build:capacitor": "vite build --config vite.capacitor.config.mts",
        "cap:sync": "npm run build:capacitor && npx cap sync",
        "cap:ios": "npx cap open ios",
        "cap:android": "npx cap open android",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "api": "npx swagger-typescript-api generate --axios --path storage/api-docs/api-docs.json --custom-config {} --output resources/types --name='Api.gen.ts'",
        "api-ns": "npx swagger-typescript-api generate --path storage/api-docs/api-docs.json --custom-config {} --output resources/types --name='Api.nativescript.gen.ts'",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "cy:open": "cypress open",
        "cy:run": "cypress run"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.5.1",
        "@eslint/js": "^10.0.0",
        "@rushstack/eslint-patch": "^1.12.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.0.14",
        "@types/luxon": "^3.6.2",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-prettier": "^10.0.0",
        "@vue/eslint-config-typescript": "^14.0.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.8.2",
        "concurrently": "^10.0.0",
        "cypress": "^16.0.0",
        "daisyui": "^5.5.3",
        "eslint": "^10.0.0",
        "eslint-plugin-vue": "^10.3.0",
        "globals": "^17.0.0",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.3.0",
        "prettier-plugin-organize-imports": "^4.0.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "swagger-typescript-api": "^13.12.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.0",
        "vite": "^8.0.0",
        "vitepress": "^2.0.0-alpha.15",
        "vue": "^3.4.0",
        "vue-tsc": "^3.0.0"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.1",
        "@capacitor/app": "^8.1.1",
