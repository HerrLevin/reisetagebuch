        "@tailwindcss/postcss": "^4.1.2",
        "lucide-vue-next": "^1.0.0",
        "luxon": "^3.6.1",
        "maplibre-gl": "^6.9.0",
        "markdown-it": "^15.0.0",
        "pinia": "^4.0.2",
        "pinia-plugin-persistedstate": "^4.7.1",
        "vite-plugin-pwa": "^1.0.0",
        "vue-debounce": "^5.0.1",
        "vue-i18n": "^11.1.12",
        "vue-router": "^5.2.0"
    },
    "overrides": {
        "serialize-javascript": ">=7.0.3",
