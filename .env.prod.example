APP_NAME=Reisetagebuch
APP_ENV=production
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=http://localhost
APP_REGISTRATION=true # set to false to disable registration

# Trust X-Forwarded-* headers from your reverse proxy, so Laravel sees the real client
# IP/scheme instead of the proxy's. '*' trusts the immediate connecting peer, which is
# safe here since rtb.prod publishes no ports and is only reachable through the proxy.
TRUSTED_PROXIES=*

PHP_CLI_SERVER_WORKERS=4

LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=reisetagebuch
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_CONNECTION=log

# The Horizon dashboard is disabled by default in production. Uncomment to enable it
# (it's still gated behind an admin user, see App\Providers\HorizonServiceProvider).
# HORIZON_DASHBOARD_ENABLED=true

REDIS_PASSWORD=changeme

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

## -- Socialite Providers -- ##
# Träwelling
# TRAEWELLING_BASE_URI=http://localhost:8000 # Use this if you want to use a local instance of Träwelling
TRAEWELLING_CLIENT_ID=
TRAEWELLING_CLIENT_SECRET=

## -- OSM Data -- ##
#
# Reisetagebuch resolves nearby points of interest (shops, stations, landmarks, ...) through the
# Overpass API (https://wiki.openstreetmap.org/wiki/Overpass_API) by default, which can be slow or time out under
# load. As an alternative, you can bulk-import the same kind of data from a Geofabrik(https://download.geofabrik.de/)
# `.osm.pbf` extract directly into the database, ahead of time, so most lookups never need to hit Overpass at all.
# Overpass stays in place as a fallback for anything outside the extracts you import.
# APP_OSM_GEOFABRIK_EXTRACTS=https://download.geofabrik.de/europe/germany-latest.osm.pbf,https://download.geofabrik.de/europe/austria-latest.osm.pbf
